<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 绑定类型图标 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <TextView
                android:id="@+id/bindingIconText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textSize="16sp"
                android:gravity="center"
                tools:text="🔑" />

        </com.google.android.material.card.MaterialCardView>

        <!-- 绑定名称 + 类型 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bindingNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="MY_KV" />

            <TextView
                android:id="@+id/bindingTypeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="KV 命名空间" />

        </LinearLayout>

        <!-- 必填标识 -->
        <com.google.android.material.chip.Chip
            android:id="@+id/requiredChip"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:minHeight="20dp"
            app:chipMinHeight="20dp"
            android:text="@string/store_required"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 绑定描述（可选） -->
    <TextView
        android:id="@+id/bindingDescText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="42dp"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorTertiary"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone"
        tools:text="存储用户数据的 KV 命名空间"
        tools:visibility="visible" />

</LinearLayout>
