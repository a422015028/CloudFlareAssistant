<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/zt_ssh_ca_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/zt_ssh_ca_intro"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <ProgressBar
            android:id="@+id/sshCaProgressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <!-- Empty state: no CA generated yet -->
        <LinearLayout
            android:id="@+id/sshCaEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔐"
                android:textSize="48sp"
                android:layout_marginBottom="16dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/zt_ssh_ca_empty_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/zt_ssh_ca_empty_desc"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="24dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sshCaGenerateBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zt_ssh_ca_generate"
                app:icon="@drawable/ic_key"
                app:iconGravity="textStart" />

        </LinearLayout>

        <!-- CA exists state: show public key -->
        <LinearLayout
            android:id="@+id/sshCaContentState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/zt_ssh_ca_public_key_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/sshCaPublicKeyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sshCaCopyBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/zt_ssh_ca_copy"
                app:icon="@drawable/ic_content_copy"
                app:iconGravity="textStart"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/zt_ssh_ca_info"
                android:textSize="13sp"
                android:padding="12dp"
                android:background="@drawable/bg_log_card" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
