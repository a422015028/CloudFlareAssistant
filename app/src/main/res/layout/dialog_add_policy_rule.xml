<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Rule Type Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xml_dialog_add_policy_rule"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/ruleTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp" />

        <!-- Dynamic Input Container -->
        <LinearLayout
            android:id="@+id/dynamicInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Email Input (for email type) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/zt_rule_type_email"
                android:visibility="gone"
                app:endIconMode="clear_text"
                app:helperText="@string/xml_dialog_add_policy_rule_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email Domain Input (for email_domain type) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailDomainLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/zt_rule_type_email_domain"
                android:visibility="gone"
                app:endIconMode="clear_text"
                app:helperText="@string/xml_dialog_add_policy_rule_helper_2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailDomainInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- IP Input (for ip type) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ipLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/xml_dialog_add_policy_rule_hint"
                android:visibility="gone"
                app:endIconMode="clear_text"
                app:helperText="@string/xml_dialog_add_policy_rule_helper_3">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ipInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Group Selector (for access_group type) -->
            <LinearLayout
                android:id="@+id/groupLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xml_dialog_add_policy_rule_2"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/groupSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />

            </LinearLayout>

            <!-- Geo Input (for geo type) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/geoLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/snippet_field_country_code"
                android:visibility="gone"
                app:endIconMode="clear_text"
                app:helperText="@string/xml_dialog_add_policy_rule_helper_4">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/geoInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLength="2"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Everyone (no input needed) -->
            <TextView
                android:id="@+id/everyoneText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xml_dialog_add_policy_rule_3"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Certificate Common Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/commonNameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/zt_rule_type_common_name"
                android:visibility="gone"
                app:endIconMode="clear_text"
                app:helperText="@string/xml_dialog_add_policy_rule_helper_5">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/commonNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
