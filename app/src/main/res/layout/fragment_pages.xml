<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Upload Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/deployCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/deployCardHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/xml_fragment_pages"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/deployCardArrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_arrow_down"
                            android:rotation="0" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/deployCardContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/xml_fragment_pages_hint"
                            app:boxBackgroundMode="outline"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_marginBottom="10dp">

                            <AutoCompleteTextView
                                android:id="@+id/projectNameEdit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/xml_fragment_pages_hint_2"
                            app:boxBackgroundMode="outline"
                            android:layout_marginBottom="10dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/branchEdit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:text="main" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/xml_fragment_pages_hint_3"
                            app:placeholderText="输入格式：2026-06-16"
                            app:boxBackgroundMode="outline"
                            android:layout_marginBottom="10dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/compatibilityDateEdit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="date" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/xml_fragment_pages_hint_4"
                            app:placeholderText="例如：nodejs_compat"
                            app:boxBackgroundMode="outline"
                            android:layout_marginBottom="10dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/compatibilityFlagsEdit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine"
                                android:minLines="1"
                                android:maxLines="4"
                                android:gravity="top|start"
                                android:scrollbars="vertical"
                                android:imeOptions="flagNoExtractUi" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/xml_fragment_pages_hint_5"
                            app:boxBackgroundMode="outline"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/filePathEdit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textUri"
                                android:imeOptions="flagNoExtractUi" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/selectFileBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/worker_select_file"
                            android:layout_marginBottom="12dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/createProjectBtn"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_weight="1"
                                android:text="@string/pages_create_project"
                                android:textSize="14sp"
                                android:layout_marginEnd="8dp"
                                style="@style/Widget.Material3.Button.OutlinedButton" />

                            <Button
                                android:id="@+id/deployBtn"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_weight="1"
                                android:text="@string/xml_fragment_pages_2"
                                android:textSize="14sp"
                                style="@style/Widget.Material3.Button" />

                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/uploadProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"
                            style="?android:attr/progressBarStyleHorizontal" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Projects List Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Pages 主头部：标题 + Manage Deployments + Manage Projects + Refresh
                         字体放大兜底方案：4 个子元素 width=0dp+weight 按比例分配父容器宽度
                         （2 : 3 : 3 : 2，合计 10）→ 永远严格等于父宽度，绝不可能溢出；
                         长文本在按钮内部由 AppButton.Outlined/Text 的 maxLines=2+ellipsize+hyphenation 自动处理；
                         baselineAligned=false + gravity=center_vertical → 按钮间垂直中心线对齐（避免文字 2 行错落）。 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="@string/xml_fragment_pages_3"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                        
                        <Button
                            android:id="@+id/pagesCleanupDeploymentsBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:text="@string/xml_fragment_pages_4"
                            style="@style/AppButton.Outlined"
                            android:layout_marginEnd="4dp" />


                        <Button
                            android:id="@+id/pagesToggleSelectionModeBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:text="@string/pages_manage_projects"
                            style="@style/AppButton.Outlined"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/refreshBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="@string/xml_fragment_pages_5"
                            style="@style/AppButton.Text" />

                    </LinearLayout>

                    <!-- Pages 选中模式操作栏：状态文本 + 全选 + 批量删除 → 同主头部的权重分配（3:2:2，永不溢出） -->
                    <LinearLayout
                        android:id="@+id/pagesSelectionActionsLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/pagesSelectionStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:text="@string/xml_fragment_pages_6"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />

                        <Button
                            android:id="@+id/pagesSelectAllBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="@string/snippet_select_all"
                            style="@style/AppButton.Outlined"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/pagesBatchDeleteBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="@string/xml_fragment_pages_7"
                            style="@style/AppButton" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/projectRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <TextView
                        android:id="@+id/emptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/xml_fragment_pages_8"
                        android:gravity="center"
                        android:padding="24dp"
                        android:textColor="?android:textColorSecondary"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="24dp"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
