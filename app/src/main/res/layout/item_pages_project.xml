<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Project Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/projectNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="my-pages-project" />

                <TextView
                    android:id="@+id/projectInfoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp"
                    tools:text="main 分支 • 2025-12-19" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xml_item_pages_project"
                android:textSize="11sp"
                android:minWidth="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                app:icon="@android:drawable/ic_menu_sort_by_size"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

        </LinearLayout>

        <!-- Buttons Row 1 - Configuration：6 按钮均分空间，英文下最后一个 Secrets 不会跑出右边界。
             【对齐关键】baselineAligned=false + gravity=center_vertical 同上解释。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/configKvBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="KV"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_add"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/configR2Btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="R2"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_add"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/configD1Btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="D1"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_add"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/configServiceBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dns_field_service"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_add"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/configEnvBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pages_label_variable"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_add"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/configSecretBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pages_label_secret"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_add"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

        </LinearLayout>

        <!-- Buttons Row 2 - Actions：5 按钮均分空间，英文下最后一个 Delete 100% 可见（不会被截断或挤出卡片）。
             baselineAligned=false + gravity=center_vertical → 图标视觉齐平。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runtimeSettingsBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/zone_tool_settings"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_preferences"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addDomainBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/domain_add_title"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_add"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewDomainsBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/xml_item_pages_project_2"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_myplaces"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewDeploymentsBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/xml_item_pages_project_3"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_recent_history"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/delete"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
