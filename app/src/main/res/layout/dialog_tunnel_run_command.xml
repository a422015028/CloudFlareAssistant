<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tunnel_connect_instructions_old"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/tokenModeChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipModeToken"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zt_tunnel_mode_token"
            android:checked="true"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipModeJson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zt_tunnel_mode_json"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipModeYaml"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zt_tunnel_mode_yaml"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipModeRunCmd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zt_tunnel_mode_run_cmd"
            style="@style/Widget.Material3.Chip.Filter" />

    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/tokenTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="?attr/colorError"
        android:background="?attr/colorSurfaceContainer"
        android:padding="12dp"
        android:textIsSelectable="true"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/hideTokenButton"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/tunnel_hide_token"/>

        <Button
            android:id="@+id/copyCommandButton"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tunnel_copy_command"/>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/refreshTokenButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/zt_tunnel_refresh_token"
        app:icon="@android:drawable/ic_menu_rotate"
        app:iconGravity="textStart" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tunnel_token_warning"
        android:textSize="12sp"
        android:textColor="?attr/colorError"/>

</LinearLayout>