<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xml_dialog_worker_runtime_settings"
            android:textSize="12sp"
            android:textColor="?android:textColorSecondary" />

        <TextView
            android:id="@+id/scriptNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 兼容性日期 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dateInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/xml_dialog_worker_runtime_settings_hint"
            app:helperText="@string/xml_dialog_worker_runtime_settings_helper"
            app:helperTextEnabled="true"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_calendar">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/compatibilityDateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="date"
                android:text="2025-01-01" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xml_dialog_worker_runtime_settings_2"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/flagSuggestionsLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/xml_dialog_worker_runtime_settings_hint_2"
            app:helperText="@string/xml_dialog_worker_runtime_settings_helper_2">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/flagSuggestionsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/xml_dialog_worker_runtime_settings_hint_3"
            app:helperText="@string/xml_dialog_worker_runtime_settings_helper_3"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/compatibilityFlagsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 放置模式 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xml_dialog_worker_runtime_settings_3"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/placementModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/placementOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/xml_dialog_worker_runtime_settings_4" />

            <RadioButton
                android:id="@+id/placementSmart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xml_dialog_worker_runtime_settings_5" />

            <RadioButton
                android:id="@+id/placementRegion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xml_dialog_worker_runtime_settings_6" />

            <RadioButton
                android:id="@+id/placementService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xml_dialog_worker_runtime_settings_7" />

        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/placementRegionLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:hint="@string/xml_dialog_worker_runtime_settings_hint_4"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/placementRegionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/placementHostLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:hint="@string/xml_dialog_worker_runtime_settings_hint_5"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/placementHostInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
