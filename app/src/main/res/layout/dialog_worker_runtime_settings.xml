<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="脚本名称"
            android:textSize="12sp"
            android:textColor="?android:textColorSecondary" />

        <TextView
            android:id="@+id/scriptNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 兼容性日期 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dateInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="兼容性日期"
            app:helperText="格式: YYYY-MM-DD (例: 2024-01-01)，点日历图标选择"
            app:helperTextEnabled="true"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_calendar">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/compatibilityDateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="date"
                android:text="2025-01-01" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="兼容性标志"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/flagSuggestionsLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="快速添加常用标志"
            app:helperText="选择后自动追加到下方输入框">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/flagSuggestionsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="兼容性标志（可手动输入）"
            app:helperText="每行一个标志，也可从上方快速添加"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/compatibilityFlagsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 放置模式 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="放置模式 (Placement)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/placementModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/placementOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="默认（始终在靠近最终用户的位置处理请求）" />

            <RadioButton
                android:id="@+id/placementSmart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="智能（自动选择最佳位置，最大程度减少访问数据库或 API 的延迟）" />

            <RadioButton
                android:id="@+id/placementRegion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="区域（指定托管外部资源的区域，请求路由到附近以减少延迟）" />

            <RadioButton
                android:id="@+id/placementService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="服务（指定外部服务的主机名或主机:端口，Cloudflare 将就近路由）" />

        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/placementRegionLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:hint="区域代码（如 eu、apac，可选）"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/placementRegionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/placementHostLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:hint="主机名或主机:端口（可选）"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/placementHostInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
