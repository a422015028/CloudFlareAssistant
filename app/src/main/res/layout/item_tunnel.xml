<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Tunnel Name -->
        <TextView
            android:id="@+id/tunnelNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/tunnel_name"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/runCommandButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Status Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/r2_status_active"
            android:textSize="11sp"
            app:chipMinHeight="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tunnelNameText" />

        <!-- Tunnel Type Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/tunnelTypeChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            tools:text="cloudflared"
            android:textSize="11sp"
            app:chipMinHeight="24dp"
            app:layout_constraintStart_toEndOf="@id/statusChip"
            app:layout_constraintTop_toTopOf="@id/statusChip" />

        <!-- Config Source Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/configSourceChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            tools:text="远程配置"
            android:textSize="11sp"
            app:chipMinHeight="24dp"
            app:layout_constraintStart_toEndOf="@id/tunnelTypeChip"
            app:layout_constraintTop_toTopOf="@id/statusChip" />

        <!-- Connections Info -->
        <TextView
            android:id="@+id/connectionsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="4dp"
            android:text="@string/tunnel_connections_count"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            app:drawableStartCompat="@android:drawable/ic_menu_compass"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusChip" />

        <!-- Connection Details -->
        <TextView
            android:id="@+id/connectionDetailsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Colo: LAX, SJC"
            android:textColor="?android:attr/textColorTertiary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/connectionsText" />

        <!-- Created Date -->
        <TextView
            android:id="@+id/createdDateText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tunnel_created_preview"
            android:textColor="?android:attr/textColorTertiary"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/connectionDetailsText" />

        <!-- Run Command Button -->
        <ImageButton
            android:id="@+id/runCommandButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tunnel_run_command"
            android:src="@android:drawable/ic_media_play"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorPrimary" />

        <!-- Config Button (remote config tunnels) -->
        <ImageButton
            android:id="@+id/configButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tunnel_configure"
            android:src="@android:drawable/ic_menu_preferences"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/runCommandButton"
            app:tint="?attr/colorPrimary" />

        <!-- View Routes Button (local config tunnels) -->
        <ImageButton
            android:id="@+id/viewRoutesButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_view_routes"
            android:src="@android:drawable/ic_menu_view"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/runCommandButton"
            app:tint="?attr/colorPrimary" />

        <!-- Barrier to align delete button below config/viewRoutes button (whichever is visible) -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/actionBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="configButton,viewRoutesButton" />

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tunnel_delete"
            android:src="@android:drawable/ic_menu_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/actionBarrier"
            app:tint="?attr/colorError" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
