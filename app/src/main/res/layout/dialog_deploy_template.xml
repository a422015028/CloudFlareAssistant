<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 顶部把手 -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_circle_icon"
        android:alpha="0.4" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- 标题 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="@string/store_deploy_template" />

            <!-- 模板名称 -->
            <TextView
                android:id="@+id/templateNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="Template Name v1.0.0" />

            <!-- 目标账户选择 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="@string/store_target_account" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/accountInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <AutoCompleteTextView
                    android:id="@+id/accountAutoComplete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    tools:ignore="LabelFor" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Hybrid 部署方式选择（仅 Hybrid 模板显示） -->
            <LinearLayout
                android:id="@+id/hybridSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/store_deploy_mode" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/deployModeChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeBoth"
                        style="@style/AppChip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/store_deploy_both"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeWorker"
                        style="@style/AppChip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/store_worker" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModePages"
                        style="@style/AppChip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/store_pages" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

            <!-- 部署名称 -->
            <TextView
                android:id="@+id/nameLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="@string/store_template_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/store_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Pages 项目名称（仅 Hybrid + Pages 模式时显示） -->
            <LinearLayout
                android:id="@+id/pagesNameSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/store_pages_project_name" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/pagesNameInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/store_pages_name_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/pagesNameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- 绑定配置区域 -->
            <LinearLayout
                android:id="@+id/bindingsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/store_bindings" />

                <LinearLayout
                    android:id="@+id/bindingsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- 环境变量区域 -->
            <LinearLayout
                android:id="@+id/envSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/store_env_vars" />

                <LinearLayout
                    android:id="@+id/envContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- 可观测性设置 -->
            <LinearLayout
                android:id="@+id/observabilitySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/worker_post_stage_observability" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/logsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/store_observability_logs"
                    android:textSize="13sp"
                    android:checked="false" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/tracingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/store_observability_tracing"
                    android:textSize="13sp"
                    android:checked="false" />

            </LinearLayout>

            <!-- 预检结果区域 -->
            <LinearLayout
                android:id="@+id/preflightSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="?attr/colorOutlineVariant"
                    android:alpha="0.3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/store_preflighting" />

                <TextView
                    android:id="@+id/preflightText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="Worker 已存在，将覆盖现有配置" />

            </LinearLayout>

            <!-- 进度指示 -->
            <LinearLayout
                android:id="@+id/progressSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="?attr/colorOutlineVariant"
                    android:alpha="0.3" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/progressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:gravity="center"
                    tools:text="@string/store_deploying" />

            </LinearLayout>

            <!-- 分割线 + 按钮 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="?attr/colorOutlineVariant"
                android:alpha="0.3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deployBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:textSize="15sp"
                android:text="@string/store_confirm_deploy"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_cloud_upload"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
