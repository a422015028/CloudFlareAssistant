<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Script Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/scriptNameText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="my-worker" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logsBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xml_item_worker_script"
                    android:textSize="11sp"
                    android:minWidth="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    app:icon="@android:drawable/ic_menu_info_details"
                    app:iconSize="16dp"
                    app:iconPadding="2dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/scriptSizeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="4dp"
                tools:text="12.5 KB • 2025-12-13" />

        </LinearLayout>

        <!-- Buttons Row 1 - Bindings：空间均分，最右按钮绝对不会被挤出屏幕。
             中文下按钮文字短均分看起来依然紧凑；英文下每个按钮独立 slice，
             配合 AppButton.Text.Icon 的 maxLines=2+ellipsize+hyphenation，
             长文本在自身区域内自动两行/断字/省略号，不会把下一个顶出屏幕。
             【对齐关键】：baselineAligned=false + gravity=center_vertical
             → 彻底告别"按文字基线对齐"导致的参差不齐：
             LinearLayout 默认 baselineAligned=true 会把所有子元素 TextView 文字的基线
             （最末行底部基线）对齐到同一水平线，文字 2 行的按钮底部基线偏下，
             导致整个按钮（及图标）和旁边 1 行的按钮不在同一中心线。
             baselineAligned=false 改由 gravity=center_vertical 统一按**父容器垂直中心**
             对齐所有子按钮，再配合 iconGravity=start（图标对齐按钮自身中心），
             无论文字是 1 行 / 2 行、系统字体放多大，所有图标都在同一水平线上。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/configKvBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="KV"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_add"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/configR2Btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="R2"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_add"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/configD1Btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="D1"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_add"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/configServiceBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dns_field_service"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_add"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/configVariablesBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pages_label_variable"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_add"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/configSecretsBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pages_label_secret"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_add"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

        </LinearLayout>

        <!-- Buttons Row 2 - Actions：同上均分，最右 Delete/Edit 绝对可见；
             baselineAligned=false + gravity=center_vertical → 图标视觉齐平。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runtimeSettingsBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/zone_tool_settings"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_preferences"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/triggerBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/xml_item_worker_script_2"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_today"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/historyBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/xml_item_worker_script_3"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_recent_history"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/xml_item_worker_script_4"
                android:layout_marginEnd="4dp"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/delete"
                style="@style/AppButton.Text.Icon"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconSize="16dp"
                app:iconPadding="2dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
