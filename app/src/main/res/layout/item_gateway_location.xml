<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/locationNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gateway_location_name"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                android:id="@+id/defaultChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_default"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/ecsChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDNS"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/locationClientsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/gateway_clients_count"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="10sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/locationNetworksText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/gateway_source_ip_whitelist"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/locationDnsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/gateway_dns_endpoints"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dnsIpv4Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="IPv4: 162.159.36.1"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="?attr/colorPrimary"
            android:clickable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/dnsIpv6Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="IPv6: 2606:4700:4700::1111"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="?attr/colorPrimary"
            android:clickable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/dnsDotText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="DoT: xxx.cloudflaregateway.com:853"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="?attr/colorPrimary"
            android:clickable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/dnsDohText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="DoH: https://xxx.cloudflare-gateway.com/dns-query"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="?attr/colorPrimary"
            android:clickable="true"
            android:background="?attr/selectableItemBackground" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/editButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/edit"
                android:textSize="11sp" />

            <Button
                android:id="@+id/deleteButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete"
                android:textSize="11sp"
                android:textColor="?attr/colorError" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>